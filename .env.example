# Backend Environment Variables (set in Vercel Backend Project)
PORT=5000
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=7

# Frontend Environment Variables (set in Vercel Frontend Project)
VITE_API_URL=https://rfipl-backend.vercel.app